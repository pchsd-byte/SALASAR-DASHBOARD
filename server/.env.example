NODE_ENV=development
PORT=5001

# Use a separate database for development. A local server pointed at the production database
# runs a second copy of the sync and email crons against it.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/salasar

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Deployed: https://<your-render-url>/api/auth/google/... — each must also be listed under
# "Authorised redirect URIs" on the Google OAuth client. On Render, if these are left unset or
# still say localhost, the server derives them from RENDER_EXTERNAL_URL.
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:5001/api/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5001/api/auth/google/connect-drive/callback
GMAIL_SEND_REDIRECT_URI=http://localhost:5001/api/auth/google/connect-gmail/callback

# Both are required on any deployed server — it refuses to start with the development fallbacks.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-string

ADMIN_EMAILS=someone@example.com

# Who may sign in: ADMIN_EMAILS, EMAIL_USER, the addresses below, and whoever an admin
# has added under Settings -> People and access. Every other Google account is refused and
# shown the "no access" page. ALLOWED_LOGIN_DOMAINS was removed (Oct 2026) — a whole
# domain is not a permission anybody granted.
ALLOWED_LOGIN_EMAILS=

# No trailing slash (it is normalised, but keep it exact).
CLIENT_ORIGIN=http://localhost:5173

HSD_SPREADSHEET_ID=1-O9T8zA4yAFYzq9LW2fgn5hIdy7MsAPq
# Drive folder of the monthly Dispatch Synopsis workbooks (one .xlsx per month).
SYNOPSIS_FOLDER_ID=1RBlqtBL3l2qnyKxRzF0FZ_p7ruYKQRni
# When the daily sync runs. The workbook is filled in by hand once a day, in the evening, so it
# is read once a day, after that — five-digit cron, in SYNC_TIMEZONE. Syncing every ten minutes
# re-downloaded unchanged workbooks 144 times a day and exhausted Render's free 5 GB of
# bandwidth every few days. "Sync now" in Settings still runs one on demand at any time.
SYNC_CRON=30 21 * * *
SYNC_TIMEZONE=Asia/Kolkata

GEMINI_API_KEY=your-gemini-api-key

# The one account allowed to use the Email feature. Sending goes through the Gmail API (SMTP is
# blocked on Render), authorised once from the Email page while signed in as this account.
EMAIL_USER=someone@example.com
